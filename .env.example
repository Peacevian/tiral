# Copy to apps/web/.env.local and fill in real values. Never commit .env.local.
# Local dev connects to the VPS Postgres through an SSH tunnel:
#   ssh -N -L 55433:127.0.0.1:5433 geinz-vps
DATABASE_URL=postgres://tiral_app:<password>@127.0.0.1:55433/tiral

# TikTok Login Kit (register at https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be HTTPS and registered in the TikTok app's Login Kit settings
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Shared secret for session cookies + game-server join tickets (generate: openssl rand -base64 32)
SESSION_SECRET=
