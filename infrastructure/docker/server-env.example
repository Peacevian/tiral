# Copy to /opt/tiral/web.env and /opt/tiral/game.env on the server and fill in.
# NEVER commit real values. Both files must share SESSION_SECRET.

# ---- /opt/tiral/web.env ----
# DATABASE_URL=postgres://tiral_app:<password>@127.0.0.1:5433/tiral
# SESSION_SECRET=<openssl rand -base64 32>
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://tiral.geinz.lol/api/auth/tiktok/callback
# PRIVY_APP_SECRET=                       (web.env only; the game server does not need it)
# NEXT_PUBLIC_PRIVY_APP_ID is not read from this file. Pass it as a build arg
# (NEXT_PUBLIC_PRIVY_APP_ID) when building the web image. It is public.
# PORT=3100                      (nginx proxies the web app on 3100)
# PUBLIC_BASE_URL=https://tiral.geinz.lol   (webhook signatures are checked against this URL)
# BILLBOARD_UPLOAD_DIR=/data/uploads        (the compose volume; anywhere else is lost on rebuild)
# ADMIN_SECRET=<openssl rand -hex 32>       (x-admin-secret header for disabling billboards and for scripts reading /api/admin/stats)
# ADMIN_USER_IDS=<uuid>,<uuid>             (signed-in players allowed to read /api/admin/stats; find your id in /api/auth/me)
# RELWORX_API_KEY=
# RELWORX_ACCOUNT_NO=
# RELWORX_WEBHOOK_KEY=            (required in production: unsigned webhooks are refused)

# ---- /opt/tiral/game.env ----
# DATABASE_URL=postgres://tiral_app:<password>@127.0.0.1:5433/tiral
# SESSION_SECRET=<same value as web.env>
# PORT=2567
# API_PORT=2568
# RACE_COUNTDOWN_SECONDS=300
# RACE_ARRIVAL_RADIUS=25
# Test benches only (never in production): ALLOW_TEST_OVERRIDES=1 enables
# STALL_RAID_CHANCE, STALL_CUSTOMER_RATE, STALL_RAID_DELAY, HUSTLE_ARRIVAL_RADIUS
