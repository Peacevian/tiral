# syntax=docker/dockerfile:1
FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@9.15.7 --activate

WORKDIR /app

# Packages first, from the lockfile alone, so this layer (and the download cache
# under it) is reused until a dependency changes. Code-only deploys skip it.
RUN pnpm config set store-dir /pnpm-store
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm-store pnpm fetch

COPY package.json ./
COPY packages ./packages
COPY apps ./apps

RUN --mount=type=cache,target=/pnpm-store pnpm install --frozen-lockfile --offline

ARG NEXT_PUBLIC_GAME_URL=wss://playtiral.com
ARG NEXT_PUBLIC_RACES_API_URL=https://playtiral.com/races
# 1: everyone sees the new realistic bodies (apps/web/src/lib/newBodies.ts).
ARG NEXT_PUBLIC_NEW_BODIES=0
# Public app id only. Empty keeps guest play working. The secret is a runtime env, not a build arg.
ARG NEXT_PUBLIC_PRIVY_APP_ID=
ENV NEXT_PUBLIC_GAME_URL=$NEXT_PUBLIC_GAME_URL
ENV NEXT_PUBLIC_RACES_API_URL=$NEXT_PUBLIC_RACES_API_URL
ENV NEXT_PUBLIC_NEW_BODIES=$NEXT_PUBLIC_NEW_BODIES
ENV NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID

# Next's own cache is kept between builds, so only changed files recompile.
RUN --mount=type=cache,target=/app/apps/web/.next/cache pnpm --filter @tiral/web build

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["pnpm", "--filter", "@tiral/web", "start"]
